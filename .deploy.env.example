# Optional defaults for scripts/deploy.sh. Copy to .deploy.env (git-ignored)
# and adjust. Command-line arguments override these.
# The file is read by bash: quote values that contain spaces.

# Server to deploy to: an ssh host, user@host or a Host alias from your ssh config
DEPLOY_HOST=user@my-server

# Folder on the server, relative to the remote user's home
DEPLOY_DIR=encforge

# Branch to deploy (the server deploys what is on GitHub: push first)
# BRANCH=main

# ssh config file to use, and extra ssh options (e.g. a jump host)
# SSH_CONFIG=~/.ssh/config
# SSH_OPTS="-J user@jumphost"

# Repository the server clones on the first deploy (default: your origin URL).
# An https URL needs no key on the server for a public repo.
# REPO_URL=https://github.com/<owner>/encforge.git

# Private repository over SSH: the server fetches with the key
# ~/.ssh/encforge-deploy (on the server) if it exists; ~/.ssh/handbrake-ui-deploy,
# its name before the rename to EncForge, still works. Add its public key to
# the repository as a read-only deploy key. To use another key, set DEPLOY_KEY
# to its absolute path on the server.

# Deploy even while a job is converting (it restarts from 0%)
# FORCE=1
