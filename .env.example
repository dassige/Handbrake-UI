# Copy to .env next to docker-compose.yml and adjust.

# User/group the container runs as (owner of your media files): `id -u`, `id -g`
PUID=1000
PGID=1000

# Extra group for the media shares. NFS mounts from a Synology NAS usually grant
# access through the "users" group (100): check with `id` on the host.
MEDIA_GID=100

# Group id of /dev/dri/renderD128 on the host: `getent group render | cut -d: -f3`
RENDER_GID=991

# No Intel GPU on the host (or Docker Desktop on Windows/macOS)? Uncomment one:
# COMPOSE_FILE=docker-compose.yml:docker-compose.no-gpu.yml      # Linux, macOS
# COMPOSE_FILE=docker-compose.yml;docker-compose.no-gpu.yml      # Windows

# Host port for the web UI
PORT=8095

# Host folder that holds your sources and targets. On Linux it appears at the
# same path inside the container.
MEDIA_DIR=/mnt
# Windows (Docker Desktop): the host path can't be used inside the container,
# so mount it somewhere else and use that path below and in the app:
# MEDIA_DIR=C:/Videos
# MEDIA_MOUNT=/media

# Initial source and target folders, as seen inside the container (later
# changed in the UI). They must be inside MEDIA_DIR (or MEDIA_MOUNT).
SOURCE_ROOT=/mnt/downloads
TARGET_ROOT=/mnt/converted

# Time zone of the server clock; the conversion window (Settings) follows it.
# A tz database name, e.g. Europe/London, America/New_York.
TZ=UTC
