# Copy to .env next to docker-compose.yml and adjust.

# User/group the container runs as (owner of your media files): `id -u`, `id -g`
PUID=1000
PGID=1000

# Extra group for the media shares. NFS mounts from a Synology NAS usually grant
# access through the "users" group (100): check with `id` on the host.
MEDIA_GID=100

# Group id of /dev/dri/renderD128 on the host: `getent group render | cut -d: -f3`
RENDER_GID=991

# Host port for the web UI
PORT=8095

# Host folder mounted into the container at the same path
MEDIA_DIR=/mnt

# Initial source and target folders (later changed in the UI)
SOURCE_ROOT=/mnt/downloads
TARGET_ROOT=/mnt/converted

# Time zone of the server clock; the conversion window (Settings) follows it.
TZ=UTC
